# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/ksmart360

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia_esto_por_una_clave_muy_larga_y_aleatoria

# Tiempo de expiración del token JWT en minutos (default: 120)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ─── Wizard de primer arranque ────────────────────────────────────────────────
# Si la BD está vacía y NO usas el wizard web, el sistema creará estos valores al arrancar.
# Si usas el wizard web (recomendado), estas variables se ignorarán.
SUPERADMIN_EMPRESA_NOMBRE=Mi Empresa
SUPERADMIN_EMPRESA_NIT=
SUPERADMIN_COLOR=#F43F5E
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=cambia_esta_contraseña

# ─── Entorno ──────────────────────────────────────────────────────────────────
# En producción: SECRET_KEY es obligatoria (el servidor no arranca sin ella)
ENVIRONMENT=development

# ─── CORS adicionales (separados por coma) ────────────────────────────────────
EXTRA_CORS_ORIGINS=

# ─── API Keys de integración (opcionales) ────────────────────────────────────
CRON_API_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_KEY=
MATIAS_API_KEY=
