# ──────────────────────────────────────────────────────────────────────────────
# Ksmart360 — Variables de entorno para producción (OCI)
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena TODOS los valores marcados con <...>
#   3. Nunca subas el .env al repositorio (ya está en .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=ksmart
POSTGRES_USER=ksmart
# Usa una contraseña larga y aleatoria. Genera una con:
#   openssl rand -base64 32
POSTGRES_PASSWORD=<contraseña_segura_aqui>

# ── Backend FastAPI ───────────────────────────────────────────────────────────
# Clave secreta para firmar los JWT. Genera una con:
#   openssl rand -hex 32
SECRET_KEY=<clave_secreta_aqui>

# Dominio o IP pública del servidor OCI (el frontend en Vercel necesita este origen)
# Ejemplos:
#   EXTRA_CORS_ORIGINS=http://123.45.67.89
#   EXTRA_CORS_ORIGINS=https://api.tu-dominio.com
EXTRA_CORS_ORIGINS=http://<ip-publica-oci>
